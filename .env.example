# swimflow --serve configuration.
#
# Copy this file to `.env` and adjust it, or start the server with an explicit
# file: `swimflow --serve --env-file path/to/.env`. Real environment variables
# override values set here. Relative paths are resolved against the working
# directory. A `.env` file is optional; without one, the defaults below apply.
#
# CLI rendering and drill-down switches without a key here are one-shot
# settings: `swimflow -h` groups them under "CLI only", and --serve ignores
# them. The keys below are all the server understands.

# Directory scanned recursively for diagram files (default: the working
# directory). Only files of a known diagram type below this directory are
# ever served: `.diag` (activity/swimlane), `.seq` (sequence), `.tree` (tree),
# `.tmap` (treemap) and `.mfst` (manifest).
SWIMFLOW_DIR=examples

# Interface to bind. The default, 0.0.0.0, makes the server reachable from
# other machines. Use 127.0.0.1 to restrict it to this host.
SWIMFLOW_HOST=0.0.0.0

# TCP port to listen on.
SWIMFLOW_PORT=8000

# Re-render the preview after this many milliseconds without a keystroke.
SWIMFLOW_DEBOUNCE_MS=600

# Raster scale for PNG downloads (1.0 = 96 DPI; 2 doubles the pixel size).
SWIMFLOW_SCALE=1.0

# Optional shared secret. When set, the page must be opened with
# `http://host:port/?token=<value>`; a cookie then keeps the session
# authorized. Leave commented out to run without authentication.
#SWIMFLOW_TOKEN=change-me

# Font used for the live preview. Either a path to a TTF/OTF file...
#SWIMFLOW_FONT=/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf
# ...or an installed family name resolved through fontconfig. The path wins
# when both are set. The built-in VL Gothic is used when neither is set.
#SWIMFLOW_FONT_FAMILY=DejaVu Sans
